# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IBM Bob Integration
TARGET_REPO_PATH=./sample_trainee_repo
