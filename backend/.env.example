# ==========================================
# CodeMusume: The Repo Trainer Environment
# ==========================================

# AssemblyAI Voice Agent API (Dr. Agnes Tachyon's voice: STT + LLM + TTS + tools)
# Get your key at: https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# English voices: alba, eve, george, jane, jean, mary, michael (US) · anna, charles, paul, vera (UK)
ASSEMBLYAI_VOICE=vera

# What Agnes trains on startup: "lab" = a career on the bundled lab specimen
# (measured experiments), or a path to your own Python repo (free lab), e.g. ../sample_trainee_repo
TARGET_REPO_PATH=lab

# Optional: Featherless AI (typed-chat fallback when voice is off, race commentary)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
